diff --git a/src/speex/mdf_baffle.c b/src/speex/mdf_baffle.c
new file mode 100644
index 0000000..4116183
--- /dev/null
+++ b/src/speex/mdf_baffle.c
@@ -0,0 +1,6 @@
+/* Controlled experiment: same pinned MDF, only the microphone DC-notch radius changes. */
+#include "mdf.c"
+void baffle_speex_configure_notch(SpeexEchoState *s)
+{
+    s->notch_radius = expf(-6.2831853071795864769f * BF_EXPERIMENT_NOTCH_HZ / (float)s->sampling_rate);
+}
