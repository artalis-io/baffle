# Reviewed SpeexDSP 1.2.1 sources, LF-normalized SHA256.
function(baffle_speex_pin path expected)
  file(READ "${BF_SPEEXDSP_SOURCE_DIR}/${path}" content)
  string(REPLACE "\r\n" "\n" content "${content}")
  string(SHA256 actual "${content}")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "SpeexDSP source differs from reviewed pin: ${path}")
  endif()
  # Keep per-file notices, including smallft's older OggVorbis attribution.
  string(FIND "${content}" "\n#" boundary)
  if(boundary LESS 0)
    set(notice "${content}")
  else()
    string(SUBSTRING "${content}" 0 ${boundary} notice)
  endif()
  file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/SpeexDSP-source-notices.txt" "===== ${path} =====\n${notice}\n\n")
endfunction()
